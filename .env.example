# ─────────────────────────────────────────────────────────────────────────────
# Орчны хувьсагчид. Энэ файлыг `.env.local` нэрээр хуулж, утгуудыг бөглөнө.
#   cp .env.example .env.local
# `.env.local` git-д орохгүй. Нууц түлхүүрийг хэзээ ч commit хийж болохгүй.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Локал: `pnpm db:start` ажиллуулсны дараа гарах "Project URL" (ихэвчлэн http://127.0.0.1:54321).
# Production: Supabase Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Browser-т ил харагдаж болно: өгөгдлийг RLS хамгаална.
# Локал: `pnpm db:status` → "Publishable key". Production: Dashboard → API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). ЗӨВХӨН сервер талд: багш урих, лого байршуулах, seed скрипт.
# RLS-ийг тойрдог тул NEXT_PUBLIC_ угтвар хэзээ ч бүү өг, browser-т бүү дамжуул.
# Локал: `pnpm db:status` → "Secret key".
SUPABASE_SECRET_KEY=

# ── Сайт ─────────────────────────────────────────────────────────────────────
# Имэйлийн холбоосууд (баталгаажуулах, урилга, нууц үг сэргээх) энэ хаяг руу буцна.
# Production-д жишээ нь https://app.example.mn гэж өгнө (төгсгөлд "/" бичихгүй).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Платформын төлбөр хүлээн авах данс ──────────────────────────────────────
# Фитнесийн менежерт "эрх дуусах гэж байна" анхааруулга болон /billing хуудсанд харагдана.
PLATFORM_BANK_NAME=Хаан банк
PLATFORM_BANK_ACCOUNT=
PLATFORM_BANK_ACCOUNT_HOLDER=
PLATFORM_SUPPORT_PHONE=

# ── Тест ба seed (зөвхөн хөгжүүлэлтэд) ───────────────────────────────────────
# `pnpm test:db` холбогдох локал Supabase Postgres. `pnpm db:status` → "Database URL".
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Seed-ийн бүх хэрэглэгчид өгөх нууц үг (зөвхөн локал).
SEED_PASSWORD=Demo12345
