{
  "name": "gym",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "tsx scripts/db-types.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/make-admin.ts",
    "dev:cloud": "node --env-file=.env.cloud.local node_modules/next/dist/bin/next dev",
    "cloud:check": "tsx scripts/cloud.ts check",
    "cloud:link": "tsx scripts/cloud.ts link",
    "cloud:push:dry": "tsx scripts/cloud.ts push --dry-run",
    "cloud:push": "tsx scripts/cloud.ts push",
    "cloud:auth": "tsx scripts/cloud.ts auth",
    "cloud:plans": "node --env-file=.env.cloud.local --import tsx scripts/cloud-plans.ts",
    "cloud:demo": "node --env-file=.env.cloud.local --import tsx scripts/cloud-demo-gyms.ts",
    "cloud:admin": "node --env-file=.env.cloud.local --import tsx scripts/make-admin.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@11.20.0"
}
